# Скопируйте в .env и подставьте значения.
# Локальный Supabase (npx supabase start) выводит URL и publishable key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Публичный адрес веб-версии — на него ведёт QR сертификата (страница проверки verify/{id}).
# Для разработки можно не задавать: будет http://localhost:8081
EXPO_PUBLIC_WEB_URL=http://localhost:8081
